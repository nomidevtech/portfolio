    for (const chunk of Object.keys(payload)) {
        const clause = payload[chunk].map(item => {
            const name = fromHyphenSlug(item.patient_name, "Valued Patient");
            const docName = item.doctor_name
                ? `Dr. ${fromHyphenSlug(item.doctor_name)}`
                : "The Doctor";
